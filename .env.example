# Telegram
BOT_TOKEN=PASTE_NEW_TOKEN_HERE
BOT_ENABLED=true
OWNER_TELEGRAM_ID=2097006037

# Runtime / persistent storage
BOT_DATA_DIR=/app/data
HOST=0.0.0.0
PORT=3000

# Telegram Mini App
MINIAPP_ENABLED=true
PUBLIC_BASE_URL=https://procontrol.bothost.tech
# Generate unique values and keep them ONLY in Bothost environment variables.
MINIAPP_API_TOKEN=
BACKUP_ENCRYPTION_KEY=

# Reverse proxy / Bothost
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*
TRUSTED_HOSTS=procontrol.bothost.tech
CORS_ALLOWED_ORIGINS=https://procontrol.bothost.tech

# Optional PDF font if the server cannot find a system font.
# REPORT_PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
